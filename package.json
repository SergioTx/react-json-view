{
  "name": "@sergiotx/react-json-view",
  "version": "1.7.1",
  "description": "Interactive React component for inspecting JSON objects and arrays with expand/collapse.",
  "keywords": [
    "component",
    "debug",
    "devtools",
    "display",
    "inspector",
    "interactive",
    "json",
    "react",
    "tree",
    "viewer"
  ],
  "homepage": "https://github.com/sergiotx/react-json-view",
  "bugs": {
    "url": "https://github.com/sergiotx/react-json-view/issues"
  },
  "license": "MIT",
  "author": {
    "name": "SergioTx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiotx/react-json-view.git"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "contributors": "(git-authors-cli && finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "dev": "vite dev-server --config vite.config.ts --mode demo --port 2000",
    "docs:build": "vite build docs --config vite.config.ts --mode demo --outDir dist",
    "docs:dev": "vite docs --config vite.config.ts --mode demo --port 2001",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && npm run typecheck",
    "pretypecheck": "npm run build:types",
    "release:tag": "git tag -a v$(node -p \"require('./package.json').version\") -m \"v$(node -p \"require('./package.json').version\")\"",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && node scripts/check-types.mjs"
  },
  "dependencies": {
    "react-base16-styling": "^0.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinon": "^22.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "chai": "^6.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "finepack": "^2.12.22",
    "git-authors-cli": "^1.0.54",
    "jsdom": "^30.1.3",
    "moment": "^2.31.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2",
    "simple-git-hooks": "^2.14.0",
    "sinon": "^22.1.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">= 19",
    "react-dom": ">= 19"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "oxfmt --write"
    ],
    "package.json": [
      "finepack",
      "oxfmt --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
