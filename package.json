{
  "name": "@sergiotx/react-json-view",
  "version": "1.1.1",
  "description": "Interactive React component for inspecting JSON objects and arrays with expand/collapse.",
  "keywords": [
    "component",
    "debug",
    "devtools",
    "display",
    "inspector",
    "interactive",
    "json",
    "react",
    "tree",
    "viewer"
  ],
  "homepage": "https://github.com/sergiotx/react-json-view",
  "bugs": {
    "url": "https://github.com/sergiotx/react-json-view/issues"
  },
  "license": "MIT",
  "author": {
    "name": "SergioTx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiotx/react-json-view.git"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "contributors": "(git-authors-cli && finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "dev": "vite dev-server --config vite.config.ts --mode demo --port 2000",
    "docs:build": "vite build docs --config vite.config.ts --mode demo --outDir dist",
    "docs:dev": "vite docs --config vite.config.ts --mode demo --port 2001",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && npm run typecheck",
    "postrelease": "npm stage publish --access=public && pnpm release:tags && pnpm release:github",
    "pretypecheck": "npm run build:types",
    "release": "pnpm release:version && pnpm release:changelog && pnpm release:commit && pnpm release:tag",
    "release:changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md",
    "release:commit": "git add package.json CHANGELOG.md && git commit -m \"chore(release): $(node -p \"require('./package.json').version\")\"",
    "release:github": "github-generate-release",
    "release:tag": "git tag -a v$(node -p \"require('./package.json').version\") -m \"v$(node -p \"require('./package.json').version\")\"",
    "release:tags": "git push origin HEAD:main --follow-tags",
    "release:version": "standard-version --skip.changelog --skip.commit --skip.tag",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && node scripts/check-types.mjs"
  },
  "dependencies": {
    "react-base16-styling": "~0.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@testing-library/react": "^16.3.0",
    "@types/chai": "^5.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sinon": "^21.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "chai": "~6.2.2",
    "conventional-changelog": "latest",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "github-generate-release": "latest",
    "jsdom": "~30.1.0",
    "moment": "~2.31.0",
    "nano-staged": "latest",
    "oxfmt": "~0.71.0",
    "oxlint": "~1.86.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-select": "~5.10.2",
    "simple-git-hooks": "latest",
    "sinon": "~22.1.0",
    "standard-version": "latest",
    "typescript": "7.0.2",
    "vite": "~8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": ">= 19",
    "react-dom": ">= 19"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "oxfmt --write"
    ],
    "package.json": [
      "finepack",
      "oxfmt --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
